{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SyncPilot",
  "version": "0.2.2",
  "identifier": "site.jrtx.syncpilot",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SyncPilot",
        "width": 1160,
        "height": 760,
        "minWidth": 960,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "Productivity",
    "shortDescription": "Native desktop shell for Resilio Sync on Linux",
    "longDescription": "SyncPilot is an unofficial native desktop shell for Resilio Sync (rslsync) on Linux. It manages the rslsync daemon and embeds the official Resilio Web UI in a desktop window — the interface and workflow are the official ones, with tray, autostart, crash watchdog and in-app updates on top.",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/turinglambdaai/syncpilot/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERERjk3QzBBQzg5QzFDNzMKUldSekhKeklDbno1M2NCTzF5aUlVN3NrS0VVZm1EeTBLYVFpdEdSSlNhbUpwaFJ3VkdhNURkMncK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
