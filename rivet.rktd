#hasheq((name . "syncpilot")
        (display-name . "SyncPilot")
        (version . "0.8.4")
        (build . 5)
        (identifier . "site.jrtx.syncpilot")
        (release-channel . stable)
        (url-schemes . ())
        (file-associations . ())
        (macos-min-version . "14.0")
        (windows-min-version . "10.0.19041.0")
        (backend . "app/backend.rkt")
        (module . "backend")
        (entry . "start")
        (protocol . 1)
        (macos-icon . "assets/syncpilot.icns")
        (windows-icon . "assets/syncpilot.ico")
        (linux-icon . "assets/icon-512.png")
        (linux-formats . ("deb" "rpm" "appimage")))
